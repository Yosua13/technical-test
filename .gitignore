# Runtime Logs & PIDs (Local Execution Artifacts)
.run-logs/
*.out.log
*.err.log
.run-pids.json

# Local Upload & Storage Cache
siapbos-uploader/Storage/
siapbos-uploader/storage/
Storage/
storage/
*.pdf

# .NET Build Artifacts
**/[Bb]in/
**/[Oo]bj/
**/[Dd]ebug/
**/[Rr]elease/
*.dll
*.exe
*.pdb
*.cache
*.cache.json
*.AssemblyInfo.cs
*.AssemblyInfoInputs.cache
*.AssemblyReference.cache
*.FileListAbsolute.txt
*.assets.cache
*.genruntimeconfig.cache
project.assets.json
project.nuget.cache
*.nuget.dgspec.json
*.nuget.g.props
*.nuget.g.targets

# IDE & Editor Files
.vs/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
*.user
*.suo
*.userosscache
*.sln.docstates

# Node.js & Angular
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.angular/
dist/
tmp/
out-tsc/
.sass-cache/

# OS Specific
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
